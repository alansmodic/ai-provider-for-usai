<?xml version="1.0"?>
<ruleset name="AI Provider for USAi">
	<description>Coding standards for the USAi AI provider plugin.</description>

	<file>./includes/</file>
	<file>./plugin.php</file>
	<file>./uninstall.php</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="20"/>
	<arg name="severity" value="1"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="7.4-"/>

	<!--
		VIP Go first so infrastructure rules apply, then Core/Extra/Docs for WordPress
		plugin best practices. FileName is excluded because the PHP AI Client SDK
		requires PSR-4 class files.
	-->
	<rule ref="WordPress-VIP-Go"/>
	<rule ref="WordPress-Core">
		<exclude name="Generic.Files.OneObjectStructurePerFile"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ai-provider-for-usai"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="AI_PROVIDER_FOR_USAI"/>
				<element value="ai_provider_for_usai"/>
				<element value="AlanSmodic"/>
			</property>
		</properties>
	</rule>

	<!-- SDK contracts require camelCase method names. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/includes/*</exclude-pattern>
	</rule>
</ruleset>
